# --- Application ---
APP_NAME=market-intelligence
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
POSTGRES_USER=market_intel
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=market_intelligence

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Redis (session store for dashboard login — see app/auth/session_store.py) ---
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth / dashboard sessions ---
# session_cookie_secure=true (the default) requires the app to be served
# over HTTPS — a real browser will not send a Secure cookie back over
# plain HTTP, so dashboard login will not work until you're behind TLS
# (see the nginx + self-signed cert setup in the README). Set this to
# false only for local plain-HTTP development.
SESSION_COOKIE_NAME=session_id
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- 5paisa provider (see https://www.5paisa.com/developerapi/) ---
# Leave blank in dev — the provider stays disconnected and market data jobs
# skip themselves instead of failing when fivepaisa_configured is false.
FIVEPAISA_APP_NAME=
FIVEPAISA_APP_SOURCE=
FIVEPAISA_USER_ID=
FIVEPAISA_PASSWORD=
FIVEPAISA_USER_KEY=
FIVEPAISA_ENCRYPTION_KEY=
FIVEPAISA_CLIENT_CODE=
FIVEPAISA_PIN=
FIVEPAISA_TOTP_SECRET=

FIVEPAISA_REQUEST_TIMEOUT=30
FIVEPAISA_MAX_RETRIES=3
FIVEPAISA_RETRY_BACKOFF_SECONDS=2
FIVEPAISA_RATE_LIMIT_PER_SEC=5
FIVEPAISA_DAILY_HISTORY_DAYS=400

# --- Upstox provider (primary market-data provider — see ACTIVE_MARKET_DATA_PROVIDER) ---
# Current setup is a static Analytics Token, not the OAuth authorization-code
# flow — this project is read-only market-data/analytics/alerting and never
# places orders, so there's no callback route and none is planned. Only
# UPSTOX_ACCESS_TOKEN is actually read by UpstoxProvider.connect()
# (app/providers/upstox_provider.py) today.
#
# REQUIRED for the current static-token setup:
#   UPSTOX_ACCESS_TOKEN — an Analytics Token: read-only, no order
#     placement, valid for 1 year from generation (does not require daily
#     OAuth re-authorization). Generate from Upstox Developer Apps ->
#     Analytics. Treat as a secret: never commit a real value.
#
# NOT required today — reserved for a possible future OAuth
# authorization-code flow, defined in Settings but not read by any code path
# yet (no callback route exists, none is being added):
#   UPSTOX_API_KEY, UPSTOX_API_SECRET, UPSTOX_REDIRECT_URI
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=

# Which MarketDataProvider app.main constructs for the collector/pipeline —
# "upstox" (default) or "fivepaisa". FivePaisa is always used separately for
# F&O-universe-root derivation regardless of this setting (see app/main.py).
ACTIVE_MARKET_DATA_PROVIDER=upstox

# --- Feature engine ---
FEATURE_RS_BENCHMARK_SYMBOL=NIFTY
FEATURE_DAILY_LOOKBACK_BARS=500

# --- Scanner engine: Breakout Scanner v1 ---
SCANNER_BREAKOUT_ADX_THRESHOLD=20
SCANNER_BREAKOUT_RELATIVE_VOLUME_THRESHOLD=1.5
SCANNER_BREAKOUT_VOLUME_INCREASING_MIN_RELATIVE_VOLUME=1.0
SCANNER_BREAKOUT_RESISTANCE_PROXIMITY_PCT=3.0
SCANNER_MIN_QUALIFYING_SCORE=60

# --- Scanner engine: Momentum Scanner v1 ---
SCANNER_MOMENTUM_MIN_SCORE=50

# --- Data-freshness guard (app.health.freshness) ---
FEATURE_FRESHNESS_MAX_LAG_DAYS=2

# --- Universe reconciliation safety guard (symbol refresh job) ---
UNIVERSE_RECONCILIATION_MIN_FRACTION=0.5

# Composite score weights — should sum to 1.0
SCANNER_SCORE_WEIGHT_TREND=0.25
SCANNER_SCORE_WEIGHT_MOMENTUM=0.20
SCANNER_SCORE_WEIGHT_VOLUME=0.20
SCANNER_SCORE_WEIGHT_VOLATILITY=0.10
SCANNER_SCORE_WEIGHT_RELATIVE_STRENGTH=0.10
SCANNER_SCORE_WEIGHT_SUPPORT_RESISTANCE=0.15

# --- Decision engine: Decision Rules v1 ---
DECISION_MIN_ALERT_SCORE=80
DECISION_MIN_RVOL=2.0
DECISION_MIN_ADX=25
DECISION_RESISTANCE_DISTANCE_PERCENT=3.0
DECISION_MAX_DATA_AGE_DAYS=1

# --- Alert manager ---
ALERT_COOLDOWN_MINUTES=30
ALERT_HIGH_PRIORITY_SCORE=90
ALERT_EXPIRY_MINUTES=240
ALERT_MAX_RETRIES=3
ALERT_RETRY_DELAY_SECONDS=5

# --- Market session (shared by MarketStatusUpdater and the decision engine) ---
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15:00
MARKET_CLOSE_TIME=15:30:00

# --- Telegram Bot API (see https://core.telegram.org/bots/api) ---
# Leave blank in dev — the provider stays unconfigured and alert delivery is
# skipped (logged, not sent) instead of failing when telegram_configured is false.
# This "default" bot carries breakout_v1 alerts — it predates the IPO/F&O
# bot split below. Connect/request timeout and retry settings are shared
# by all three bots.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONNECT_TIMEOUT=10
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF_SECONDS=2

# --- Dedicated Telegram bots for IPO and F&O candidate alerts ---
# Separate bot + chat per channel so IPO alerts and F&O alerts are
# physically impossible to cross-deliver (see app/notifications/router.py).
# Leave either blank to leave that channel unconfigured — its alerts will
# still be created/queued/retried, they just won't be delivered until
# credentials are set.
IPO_TELEGRAM_BOT_TOKEN=
IPO_TELEGRAM_CHAT_ID=
FNO_TELEGRAM_BOT_TOKEN=
FNO_TELEGRAM_CHAT_ID=

# --- Compounding / Opportunity Layer (app/compounding/) ---
# Reuses existing technical levels + Fundamental Score; no new data source.
COMPOUNDING_ATR_STOP_MULTIPLIER=1.5
COMPOUNDING_WEIGHT_UPSIDE=0.35
COMPOUNDING_WEIGHT_RISK_REWARD=0.30
COMPOUNDING_WEIGHT_HIGHER_TIMEFRAME=0.15
COMPOUNDING_WEIGHT_FUNDAMENTAL=0.20
COMPOUNDING_STRONG_SCORE_THRESHOLD=75
COMPOUNDING_TRADE_SCORE_THRESHOLD=55

# --- Trendlyne MCP (Phase 7 fundamental-data source) ---
# Full remote MCP server URL including its auth token as a query parameter,
# e.g. https://mcp.trendlyne.com/mcp/?token=<your-token> — obtained from a
# paid Trendlyne MCP subscription (see trendlyne.com/subscription/mcp/plans/).
# Leave blank in dev — the provider stays disconnected and candidates get
# an honest UNKNOWN Fundamental Score instead of failing. Treat this value
# as a secret: it is bearer-equivalent access, never commit a real one.
TRENDLYNE_MCP_URL=
TRENDLYNE_MCP_REQUEST_TIMEOUT=20
# Separate, short timeout for /health's Trendlyne liveness check only —
# keeps /health fast (and Docker's 5s container healthcheck passing) even
# when Trendlyne is unreachable. Never used for the real data fetch above.
TRENDLYNE_HEALTH_CHECK_TIMEOUT_SECONDS=2
FUNDAMENTAL_CACHE_TTL_MINUTES=240

# --- Fundamental Queue (Phase 7.x) ---
# Protects the Trendlyne quota: candidates are fetched in small paced
# batches, never all at once. Tune against Trendlyne's actual limits.
FUNDAMENTAL_BATCH_SIZE=10
FUNDAMENTAL_BATCH_DELAY_SECONDS=30
FUNDAMENTAL_REQUEST_DELAY_SECONDS=2
FUNDAMENTAL_RATE_LIMIT_COOLDOWN_SECONDS=1800
# Trendlyne gives no reset-time info, so consecutive rate limits back off
# instead of retrying at a fixed interval forever: cooldown*multiplier^n,
# capped at the max below.
FUNDAMENTAL_RATE_LIMIT_BACKOFF_MULTIPLIER=2
FUNDAMENTAL_RATE_LIMIT_MAX_COOLDOWN_SECONDS=21600
FUNDAMENTAL_MAX_REQUESTS_PER_RUN=200
FUNDAMENTAL_MAX_REQUESTS_PER_DAY=350
