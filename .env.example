# --- Application ---
APP_NAME=market-intelligence
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
POSTGRES_USER=market_intel
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=market_intelligence

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Redis (optional) ---
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Logging ---
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
